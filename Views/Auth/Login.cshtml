@model CrmLeadManagement.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In · VisionCRM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Sign in to your VisionCRM account to manage leads, projects, finances, and team workflows." />
    
    <!-- Modern Typography: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <style>
        :root {
            /* Corporate Blue Color Palette */
            --crm-blue-950: #071329;       /* Deepest midnight blue */
            --crm-blue-900: #0d2857;       /* Deep navy blue */
            --crm-blue-800: #1e3a8a;       /* Classic corporate navy */
            --crm-blue-700: #1d4ed8;       /* Primary blue dark */
            --crm-blue-600: #2563eb;       /* Primary vibrant blue */
            --crm-blue-500: #3b82f6;       /* Blue accent */
            --crm-blue-400: #60a5fa;       /* Light blue accent */
            --crm-blue-200: #bfdbfe;       /* Border blue */
            --crm-blue-100: #dbeafe;       /* Tint blue */
            --crm-blue-50:  #eff6ff;       /* Very light blue background */
            --crm-bg-soft:  #f0f7ff;       /* Soft sky background */
            
            --crm-navy-dark: #0f172a;      /* Slate 900 - Headings & deep text */
            --crm-navy-subtle: #1e293b;    /* Slate 800 - Secondary text */
            --crm-border-color: #cbd5e1;   /* Clean input border */
            --crm-border-card: #bfdbfe;    /* Card subtle border */
            --crm-text-muted: #64748b;     /* Slate 500 - Body / muted text */
            --crm-text-light: #94a3b8;     /* Slate 400 - Tertiary text */
            
            --crm-danger: #dc2626;
            --crm-danger-bg: #fef2f2;
            --crm-danger-border: #fecaca;
            --crm-success: #16a34a;
            --crm-success-bg: #f0fdf4;
            --crm-success-border: #bbf7d0;

            --radius-input: 9px;
            --radius-btn: 9px;
            --radius-card: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--crm-bg-soft);
            color: var(--crm-navy-dark);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Two-Column Desktop Shell */
        .auth-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* =========================================================
           LEFT SECTION: Enterprise Branding & Blue Gradient Showcase
           ========================================================= */
        .auth-brand-column {
            flex: 1 1 50%;
            background: linear-gradient(145deg, var(--crm-blue-950) 0%, var(--crm-blue-900) 45%, var(--crm-blue-800) 100%);
            border-right: 1px solid rgba(59, 130, 246, 0.2);
            padding: 64px 72px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        /* Decorative Glowing Background Orbs */
        .auth-brand-column::before {
            content: "";
            position: absolute;
            top: -100px;
            left: -60px;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.28) 0%, transparent 70%);
            pointer-events: none;
        }

        .auth-brand-column::after {
            content: "";
            position: absolute;
            bottom: -80px;
            right: -50px;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.24) 0%, transparent 70%);
            pointer-events: none;
        }

        .auth-brand-inner {
            position: relative;
            z-index: 2;
        }

        /* Logo Brand Mark */
        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo-mark {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--crm-blue-500), var(--crm-blue-700));
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.5px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
        }

        .brand-logo-text {
            font-size: 22px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-logo-text .brand-badge {
            font-size: 11px;
            font-weight: 700;
            color: #93c5fd;
            background: rgba(59, 130, 246, 0.22);
            border: 1px solid rgba(147, 197, 253, 0.35);
            padding: 2px 7px;
            border-radius: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Brand Pitch & Features */
        .brand-body {
            max-width: 500px;
            margin: 48px 0;
            position: relative;
            z-index: 2;
        }

        .brand-heading {
            font-size: 34px;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.25;
            letter-spacing: -0.6px;
            margin-bottom: 16px;
        }

        .brand-heading .brand-highlight {
            background: linear-gradient(90deg, #93c5fd, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-description {
            font-size: 15px;
            color: #cbd5e1;
            line-height: 1.6;
            margin-bottom: 36px;
        }

        /* Glassmorphic SaaS Feature Cards */
        .features-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            padding: 14px 16px;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .feature-item:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(147, 197, 253, 0.3);
            transform: translateY(-1px);
        }

        .feature-icon-box {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: 9px;
            background: rgba(59, 130, 246, 0.25);
            border: 1px solid rgba(147, 197, 253, 0.3);
            color: #93c5fd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .feature-text {
            display: flex;
            flex-direction: column;
            padding-top: 1px;
        }

        .feature-title {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 3px;
        }

        .feature-subtitle {
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.45;
        }

        /* Brand Footer / Trust Indicators */
        .brand-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            padding-top: 24px;
            font-size: 12.5px;
            color: #94a3b8;
            position: relative;
            z-index: 2;
        }

        .trust-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #cbd5e1;
            font-weight: 500;
        }

        .trust-indicator i {
            color: #34d399; /* Bright mint green lock */
            font-size: 14px;
        }

        /* =========================================================
           RIGHT SECTION: Clean Elevated Blue-Tinted Sign In Card
           ========================================================= */
        .auth-form-column {
            flex: 1 1 50%;
            background: linear-gradient(135deg, #f0f7ff 0%, #e0effe 50%, #eff6ff 100%);
            padding: 64px 72px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-form-container {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border: 1px solid var(--crm-border-card);
            border-radius: var(--radius-card);
            padding: 40px 36px;
            box-shadow: 0 20px 45px -15px rgba(30, 58, 138, 0.15), 0 4px 12px rgba(0, 0, 0, 0.03);
        }

        /* Mobile-Only Header */
        .mobile-brand-header {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
        }

        /* Form Header */
        .form-header {
            margin-bottom: 24px;
        }

        .form-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--crm-navy-dark);
            letter-spacing: -0.4px;
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 13.5px;
            color: var(--crm-text-muted);
            line-height: 1.5;
        }

        /* Demo Sandbox Credentials Bar (Blue-Themed) */
        .demo-bar {
            background-color: var(--crm-blue-50);
            border: 1px solid var(--crm-blue-200);
            border-radius: 9px;
            padding: 10px 12px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
        }

        .demo-bar-label {
            font-weight: 700;
            color: var(--crm-blue-800);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .demo-bar-pills {
            display: flex;
            gap: 6px;
        }

        .demo-pill {
            background: #ffffff;
            border: 1px solid var(--crm-blue-200);
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 11.5px;
            font-weight: 700;
            color: var(--crm-blue-700);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .demo-pill:hover {
            border-color: var(--crm-blue-600);
            color: #ffffff;
            background-color: var(--crm-blue-600);
            transform: translateY(-1px);
        }

        .demo-pill-super {
            background: #fef3c7;
            color: #92400e;
            border-color: #fde68a;
        }

        .demo-pill-super:hover {
            background: #f59e0b;
            color: #ffffff;
            border-color: #d97706;
        }

        /* Alert Notification */
        .auth-alert {
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            line-height: 1.45;
        }

        .auth-alert-danger {
            background-color: var(--crm-danger-bg);
            color: var(--crm-danger);
            border: 1px solid var(--crm-danger-border);
        }

        .auth-alert-success {
            background-color: var(--crm-success-bg);
            color: var(--crm-success);
            border: 1px solid var(--crm-success-border);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--crm-navy-subtle);
            margin-bottom: 6px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 44px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--crm-navy-dark);
            background-color: #ffffff;
            border: 1px solid var(--crm-border-color);
            border-radius: var(--radius-input);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input::placeholder {
            color: var(--crm-text-light);
        }

        .form-input:hover {
            border-color: var(--crm-blue-400);
        }

        .form-input:focus {
            border-color: var(--crm-blue-600);
            box-shadow: 0 0 0 3.5px rgba(37, 99, 235, 0.16);
        }

        .form-input.has-toggle {
            padding-right: 44px;
        }

        /* Password visibility toggle button */
        .btn-password-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--crm-text-muted);
            width: 34px;
            height: 34px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: color 0.15s ease;
        }

        .btn-password-toggle:hover {
            color: var(--crm-blue-700);
        }

        /* Auxiliary Actions: Remember Me & Forgot Password */
        .form-actions-aux {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .remember-checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            color: var(--crm-navy-subtle);
            font-weight: 500;
        }

        .remember-checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--crm-blue-600);
            border-radius: 4px;
        }

        .link-forgot-password {
            color: var(--crm-blue-600);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .link-forgot-password:hover {
            color: var(--crm-blue-800);
            text-decoration: underline;
        }

        /* Primary Submit Button (Vibrant Blue Gradient) */
        .btn-sign-in {
            width: 100%;
            height: 46px;
            background: linear-gradient(135deg, var(--crm-blue-600), var(--crm-blue-700));
            border: none;
            border-radius: var(--radius-btn);
            color: #ffffff;
            font-size: 14.5px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.15s ease;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        .btn-sign-in:hover {
            background: linear-gradient(135deg, var(--crm-blue-700), var(--crm-blue-800));
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
            transform: translateY(-1px);
        }

        .btn-sign-in:focus {
            outline: none;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.28);
        }

        .btn-sign-in:disabled {
            background: #93c5fd;
            box-shadow: none;
            cursor: not-allowed;
            transform: none;
        }

        .spinner-icon {
            display: none;
            animation: spin 0.85s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Form Footer */
        .form-footer {
            margin-top: 26px;
            padding-top: 18px;
            border-top: 1px solid var(--crm-blue-100);
            text-align: center;
            font-size: 12.5px;
            color: var(--crm-text-muted);
        }

        .form-footer a {
            color: var(--crm-blue-600);
            font-weight: 600;
            text-decoration: none;
        }

        .form-footer a:hover {
            color: var(--crm-blue-800);
            text-decoration: underline;
        }

        /* =========================================================
           RESPONSIVE BREAKPOINTS (Mobile & Tablet)
           ========================================================= */
        @@media (max-width: 960px) {
            .auth-wrapper {
                flex-direction: column;
            }

            .auth-brand-column {
                display: none;
            }

            .auth-form-column {
                flex: 1 1 100%;
                padding: 48px 20px;
                background: linear-gradient(135deg, #f0f7ff 0%, #e0effe 100%);
            }

            .auth-form-container {
                background-color: #ffffff;
                border: 1px solid var(--crm-border-card);
                border-radius: var(--radius-card);
                padding: 36px 24px;
                box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.1);
            }

            .mobile-brand-header {
                display: flex;
            }
        }

        @@media (max-width: 480px) {
            .auth-form-column {
                padding: 24px 14px;
            }

            .auth-form-container {
                padding: 28px 18px;
            }

            .demo-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .demo-bar-pills {
                width: 100%;
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <!-- =====================================================
             LEFT SECTION: VisionCRM Blue Gradient Showcase
             ===================================================== -->
        <aside class="auth-brand-column" aria-label="VisionCRM Overview">
            <div class="auth-brand-inner">
                <!-- VisionCRM Logo Mark -->
                <header class="brand-header">
                    <div class="brand-logo-mark" aria-hidden="true">
                        <span>V</span>
                    </div>
                    <div class="brand-logo-text">
                        <span>VisionCRM</span>
                        <span class="brand-badge">Enterprise</span>
                    </div>
                </header>

                <!-- Pitch and Overview -->
                <section class="brand-body">
                    <h1 class="brand-heading">
                        Manage Your Business <span class="brand-highlight">Smarter</span>
                    </h1>
                    <p class="brand-description">
                        Manage leads, track sales pipelines, coordinate project workflows, and accelerate growth from VisionCRM's unified SaaS workspace.
                    </p>

                    <!-- Feature Cards with Blue Glassmorphic Styling -->
                    <ul class="features-list">
                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-funnel-fill"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Lead &amp; Pipeline Tracking</span>
                                <span class="feature-subtitle">Capture, qualify, and track prospective opportunities through customized conversion stages.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-kanban-fill"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Project &amp; Milestone Workspaces</span>
                                <span class="feature-subtitle">Coordinate client deliverables, sprint tasks, and dependencies with full team visibility.</span>
                            </div>
                        </li>

                        <li class="feature-item">
                            <div class="feature-icon-box" aria-hidden="true">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="feature-text">
                                <span class="feature-title">Enterprise Security &amp; Invoicing</span>
                                <span class="feature-subtitle">Enforce role-based access controls alongside automated quotations, invoices, and audit logs.</span>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>

            <!-- Trust & Encryption Footer -->
            <footer class="brand-footer">
                <span>&copy; @DateTime.UtcNow.Year VisionCRM Inc.</span>
                <span class="trust-indicator">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i> 256-bit TLS Encrypted
                </span>
            </footer>
        </aside>

        <!-- =====================================================
             RIGHT SECTION: Modern Professional Authentication Form
             ===================================================== -->
        <main class="auth-form-column" role="main">
            <div class="auth-form-container">
                <!-- Mobile-Only Brand Header -->
                <header class="mobile-brand-header">
                    <div class="brand-logo-mark" style="width:36px;height:36px;font-size:18px;" aria-hidden="true">
                        <span>V</span>
                    </div>
                    <div class="brand-logo-text" style="color:var(--crm-navy-dark);">
                        <span>VisionCRM</span>
                    </div>
                </header>

                <header class="form-header">
                    <h2 class="form-title" id="loginTitle">Sign in to your account</h2>
                    <p class="form-subtitle">Welcome back to VisionCRM. Enter your credentials to access your workspace.</p>
                </header>

                <!-- Subtle Demo Credentials Filler -->
                <aside class="demo-bar" aria-label="Demo login options">
                    <span class="demo-bar-label">
                        <i class="bi bi-lightning-charge-fill" style="color: var(--crm-blue-600);"></i> Quick Fill:
                    </span>
                    <div class="demo-bar-pills">
                        <button type="button" class="demo-pill demo-pill-super" onclick="fillCredentials('@(ViewBag.SuperAdminEmail ?? "superadmin@visioncrm.com")', '@(ViewBag.SuperAdminPassword ?? "SuperAdmin123!")')" title="Load Super Admin credentials">
                            <i class="bi bi-shield-shaded" style="margin-right:3px;"></i> Super Admin
                        </button>
                        <button type="button" class="demo-pill" onclick="fillCredentials('@(ViewBag.AdminEmail ?? "admin@visioncrm.com")', '@(ViewBag.AdminPassword ?? "AdminPassword123!")')" title="Load Administrator credentials">
                            Admin
                        </button>
                        <button type="button" class="demo-pill" id="userOptionBtn" onclick="fillCredentials('@(ViewBag.UserEmail ?? "ananya.sharma@visioncrm.com")', '@(ViewBag.UserPassword ?? "Ananya@123!")')" title="Load User credentials">
                            User
                        </button>
                    </div>
                </aside>

                <!-- Alert Message Banner -->
                <div id="authAlert" class="auth-alert auth-alert-danger" style="@(string.IsNullOrEmpty(Model?.ErrorMessage) ? "display:none;" : "")" role="alert">
                    <i class="bi bi-exclamation-circle-fill" style="margin-top:2px;" aria-hidden="true"></i>
                    <span id="authAlertText">@(Model?.ErrorMessage ?? "")</span>
                </div>

                <!-- Main Login Form -->
                <form id="loginForm" method="post" action="/login" onsubmit="handleLoginSubmit(event)" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" id="returnUrlInput" value="@Model?.ReturnUrl" />

                    <!-- User ID / Email Input -->
                    <div class="form-group">
                        <label class="form-label" for="userIdInput">User ID or Work Email</label>
                        <div class="input-container">
                            <input type="text"
                                   id="userIdInput"
                                   name="UserId"
                                   class="form-input"
                                   placeholder="e.g. admin@visioncrm.com or User ID"
                                   value="@(Model?.UserId ?? Model?.Email ?? "")"
                                   required
                                   autocomplete="username"
                                   autofocus />
                        </div>
                    </div>

                    <!-- Password Input with Eye Visibility Toggle -->
                    <div class="form-group">
                        <label class="form-label" for="passwordInput">Password</label>
                        <div class="input-container">
                            <input type="password"
                                   id="passwordInput"
                                   name="Password"
                                   class="form-input has-toggle"
                                   placeholder="Enter your password"
                                   required
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="btn-password-toggle"
                                    id="togglePasswordBtn"
                                    onclick="togglePasswordVisibility()"
                                    aria-label="Show password"
                                    title="Show password">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="form-actions-aux">
                        <label class="remember-checkbox-group" for="rememberMeCheckbox">
                            <input type="checkbox"
                                   id="rememberMeCheckbox"
                                   name="RememberMe"
                                   value="true"
                                   @(Model?.RememberMe == true ? "checked" : "") />
                            <span>Remember me</span>
                        </label>
                        <a href="javascript:void(0)" class="link-forgot-password" onclick="handleForgotPassword()" id="forgotPasswordLink">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Primary Action Button (Blue Gradient) -->
                    <button type="submit" class="btn-sign-in" id="submitBtn">
                        <i class="bi bi-arrow-repeat spinner-icon" id="submitSpinner" aria-hidden="true"></i>
                        <span id="submitBtnText">Sign In</span>
                    </button>
                </form>

                <!-- Help Footer -->
                <footer class="form-footer">
                    <span>Having trouble logging in? <a href="javascript:void(0)" onclick="handleForgotPassword()">Contact Administrator</a></span>
                </footer>
            </div>
        </main>
    </div>

    <!-- =========================================================
         Client Logic & Asynchronous Authentication Handler
         ========================================================= -->
    <script>
        // 1-Click Demo Credentials Autofill
        function fillCredentials(userId, password) {
            const userInput = document.getElementById('userIdInput');
            const passwordInput = document.getElementById('passwordInput');
            if (userInput) userInput.value = userId;
            if (passwordInput) passwordInput.value = password;
            hideAlert();
            if (passwordInput) passwordInput.focus();
        }

        // Toggle Password Visibility
        function togglePasswordVisibility() {
            const pwd = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            const btn = document.getElementById('togglePasswordBtn');
            if (!pwd || !icon || !btn) return;

            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'bi bi-eye-slash';
                btn.title = 'Hide password';
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                pwd.type = 'password';
                icon.className = 'bi bi-eye';
                btn.title = 'Show password';
                btn.setAttribute('aria-label', 'Show password');
            }
        }

        // Display user notifications
        function showAlert(message, isSuccess = false) {
            const alertBox = document.getElementById('authAlert');
            const alertText = document.getElementById('authAlertText');
            if (!alertBox || !alertText) return;

            alertText.textContent = message;
            alertBox.className = isSuccess ? 'auth-alert auth-alert-success' : 'auth-alert auth-alert-danger';
            alertBox.style.display = 'flex';
        }

        function hideAlert() {
            const alertBox = document.getElementById('authAlert');
            if (alertBox) alertBox.style.display = 'none';
        }

        // Forgot password prompt
        function handleForgotPassword() {
            showAlert('Please reach out to your system administrator (admin@visioncrm.com) to reset credentials or verify account permissions.', false);
        }

        // Asynchronous form submission preserving bearer token caching & fallback
        async function handleLoginSubmit(event) {
            event.preventDefault();
            hideAlert();

            const form = document.getElementById('loginForm');
            const userInput = document.getElementById('userIdInput');
            const passwordInput = document.getElementById('passwordInput');
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');

            const userId = (userInput?.value || '').trim();
            const password = passwordInput?.value || '';

            if (!userId && !password) {
                showAlert('Please enter both User ID / Email and Password.');
                userInput?.focus();
                return;
            }

            if (!userId) {
                showAlert('Please enter your User ID or Email.');
                userInput?.focus();
                return;
            }

            if (!password) {
                showAlert('Please enter your password.');
                passwordInput?.focus();
                return;
            }

            // Enter loading state
            submitBtn.disabled = true;
            submitSpinner.style.display = 'inline-block';
            submitBtnText.textContent = 'Signing in...';

            try {
                const formData = new FormData(form);

                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                let result = null;
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    result = await response.json();
                }

                if (response.ok && result && result.success) {
                    // Cache Bearer access token and user metadata for client API calls
                    if (result.token) {
                        try {
                            localStorage.setItem('crm_token', result.token);
                            if (result.user) {
                                localStorage.setItem('crm_user', JSON.stringify(result.user));
                            }
                        } catch (e) {
                            console.warn('LocalStorage error:', e);
                        }
                    }

                    submitBtnText.textContent = 'Redirecting...';
                    showAlert('Signed in successfully! Redirecting...', true);

                    const target = result.redirectUrl || '/Lead/List';
                    setTimeout(() => {
                        window.location.href = target;
                    }, 350);
                } else {
                    const errorMsg = result?.message || 
                        (response.status === 423 ? 'Account temporarily locked due to failed login attempts.' : 
                         response.status === 403 ? 'Account is inactive. Please contact your administrator.' : 
                         'Invalid User ID or Password.');
                    showAlert(errorMsg);
                    resetSubmitButton();
                }
            } catch (err) {
                console.error('Async login error, submitting via standard POST fallback:', err);
                form.submit();
            }
        }

        function resetSubmitButton() {
            const submitBtn = document.getElementById('submitBtn');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitBtnText = document.getElementById('submitBtnText');
            if (submitBtn) submitBtn.disabled = false;
            if (submitSpinner) submitSpinner.style.display = 'none';
            if (submitBtnText) submitBtnText.textContent = 'Sign In';
        }
    </script>
</body>
</html>
