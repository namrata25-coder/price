@model Product
@{
    ViewData["Title"] = "Product Details";
    ViewData["ActivePage"] = "PortfolioProduct";
    var canEdit   = ViewData["CanEditProduct"] is true;
    var canDelete = ViewData["CanDeleteProduct"] is true;
    var featureLines = (Model.Features ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<div style="max-width:860px;margin:0 auto;padding:1.75rem 1.75rem;">

    @* ── Header ── *@
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
        <div>
            <nav style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--ink-400);font-weight:500;margin-bottom:6px;">
                <a asp-controller="Product" asp-action="Index" style="color:var(--ink-400);text-decoration:none;" onmouseover="this.style.color='var(--brand-600)'" onmouseout="this.style.color='var(--ink-400)'">
                    <i class="bi bi-collection"></i> Portfolio Management
                </a>
                <i class="bi bi-chevron-right" style="font-size:10px;"></i>
                <a asp-controller="Product" asp-action="Index" style="color:var(--ink-400);text-decoration:none;" onmouseover="this.style.color='var(--brand-600)'" onmouseout="this.style.color='var(--ink-400)'">Products</a>
                <i class="bi bi-chevron-right" style="font-size:10px;"></i>
                <span style="color:var(--ink-700);">Product Details</span>
            </nav>
            <h1 style="font-size:1.55rem;font-weight:800;color:var(--ink-900);margin:0;display:flex;align-items:center;gap:10px;">
                <span style="width:38px;height:38px;background:linear-gradient(135deg,#10b981,#34d399);border-radius:10px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:17px;flex-shrink:0;">
                    <i class="bi bi-box-seam"></i>
                </span>
                @Model.Name
            </h1>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:var(--brand-600,#2563eb);color:#fff;border-radius:9px;font-size:13px;font-weight:600;text-decoration:none;transition:background .15s;"
                   onmouseover="this.style.background='var(--brand-700,#1d4ed8)'" onmouseout="this.style.background='var(--brand-600,#2563eb)'">
                    <i class="bi bi-pencil-fill"></i> Edit
                </a>
            }
            <a asp-action="Index"
               style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#fff;border:1.5px solid var(--line,#e5e7eb);border-radius:9px;font-size:13px;font-weight:600;color:var(--ink-700);text-decoration:none;"
               onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='#fff'">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @* ── Main Card ── *@
    <div style="background:#fff;border:1px solid var(--line,#e5e7eb);border-radius:14px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);">

        @* Card Header *@
        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--line,#e5e7eb);background:#fafbfc;display:flex;align-items:center;gap:10px;">
            <i class="bi bi-info-circle" style="color:#10b981;font-size:16px;"></i>
            <span style="font-size:14px;font-weight:700;color:var(--ink-700);">Product Information</span>
            <span style="margin-left:auto;font-size:12px;padding:3px 10px;background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;border-radius:20px;font-weight:600;">
                <i class="bi bi-circle-fill" style="font-size:7px;vertical-align:middle;margin-right:3px;"></i> Active
            </span>
        </div>

        @* Top Row: Name + Price *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--line,#e5e7eb);">
            <div style="padding:1.25rem 1.5rem;border-right:1px solid var(--line,#e5e7eb);">
                <div style="font-size:11px;font-weight:700;color:var(--ink-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-box-seam" style="color:var(--brand-600,#2563eb);"></i> Product Name
                </div>
                <div style="font-size:1.1rem;font-weight:800;color:var(--ink-900);">@Model.Name</div>
            </div>
            <div style="padding:1.25rem 1.5rem;">
                <div style="font-size:11px;font-weight:700;color:var(--ink-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-currency-dollar" style="color:#10b981;"></i> Price
                </div>
                <div style="font-size:1.5rem;font-weight:800;color:var(--ink-900);">
                    ₹@Model.Price.ToString("N2")
                </div>
            </div>
        </div>

        @* Description *@
        <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--line,#e5e7eb);">
            <div style="font-size:11px;font-weight:700;color:var(--ink-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
                <i class="bi bi-text-left" style="color:var(--brand-600,#2563eb);"></i> Description
            </div>
            <div style="font-size:14px;color:var(--ink-700);line-height:1.75;white-space:pre-line;">@Model.Description</div>
        </div>

        @* Features *@
        <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--line,#e5e7eb);">
            <div style="font-size:11px;font-weight:700;color:var(--ink-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                <i class="bi bi-stars" style="color:#f59e0b;"></i> Features
                <span style="font-size:11px;font-weight:600;padding:1px 8px;background:#fef3c7;color:#92400e;border-radius:10px;text-transform:none;letter-spacing:0;">@featureLines.Length</span>
            </div>
            @if (featureLines.Length == 0)
            {
                <span style="color:var(--ink-400);font-size:13px;">— No features listed</span>
            }
            else
            {
                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                    @foreach (var f in featureLines)
                    {
                        <span style="display:inline-flex;align-items:center;gap:5px;background:var(--brand-50,#eff6ff);color:var(--brand-700,#1d4ed8);border:1px solid var(--brand-200,#bfdbfe);border-radius:20px;padding:4px 12px;font-size:12.5px;font-weight:600;">
                            <i class="bi bi-check2" style="font-size:11px;"></i> @f
                        </span>
                    }
                </div>
            }
        </div>

        @* URL *@
        <div style="padding:1.25rem 1.5rem;">
            <div style="font-size:11px;font-weight:700;color:var(--ink-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
                <i class="bi bi-link-45deg" style="color:var(--brand-600,#2563eb);"></i> Product URL
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Url))
            {
                <a href="@Model.Url" target="_blank" rel="noopener noreferrer"
                   style="display:inline-flex;align-items:center;gap:7px;font-size:13.5px;color:var(--brand-600,#2563eb);font-weight:500;word-break:break-all;">
                    <i class="bi bi-box-arrow-up-right"></i>@Model.Url
                </a>
            }
            else
            {
                <span style="color:var(--ink-400);font-size:13px;">— No URL provided</span>
            }
        </div>
    </div>

    @* ── Danger Zone (Delete) ── *@
    @if (canDelete)
    {
        <div style="margin-top:1.25rem;border:1px solid #fecaca;border-radius:12px;overflow:hidden;">
            <div style="padding:.75rem 1.25rem;background:#fef2f2;border-bottom:1px solid #fecaca;display:flex;align-items:center;gap:8px;">
                <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;"></i>
                <span style="font-size:13px;font-weight:700;color:#991b1b;">Danger Zone</span>
            </div>
            <div style="padding:1rem 1.25rem;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                <div>
                    <div style="font-size:13.5px;font-weight:600;color:var(--ink-900);">Delete this product</div>
                    <div style="font-size:12px;color:var(--ink-500);margin-top:2px;">Once deleted, this product cannot be recovered.</div>
                </div>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to permanently delete &quot;@Html.Raw(Model.Name.Replace("\"","\\\""))&quot;? This action cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;background:#dc2626;color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s;"
                            onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'">
                        <i class="bi bi-trash3-fill"></i> Delete Product
                    </button>
                </form>
            </div>
        </div>
    }
</div>
