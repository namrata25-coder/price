@model ProductInputModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["ActivePage"] = "PortfolioProduct";
}

<div style="max-width:860px;margin:0 auto;padding:1.75rem 1.75rem;">

    @* ── Page Header ── *@
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
        <div>
            <nav style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--ink-400);font-weight:500;margin-bottom:6px;">
                <a asp-controller="Product" asp-action="Index" style="color:var(--ink-400);text-decoration:none;" onmouseover="this.style.color='var(--brand-600)'" onmouseout="this.style.color='var(--ink-400)'">
                    <i class="bi bi-collection"></i> Portfolio Management
                </a>
                <i class="bi bi-chevron-right" style="font-size:10px;"></i>
                <a asp-controller="Product" asp-action="Index" style="color:var(--ink-400);text-decoration:none;" onmouseover="this.style.color='var(--brand-600)'" onmouseout="this.style.color='var(--ink-400)'">Products</a>
                <i class="bi bi-chevron-right" style="font-size:10px;"></i>
                <span style="color:var(--ink-700);">Edit Product</span>
            </nav>
            <h1 style="font-size:1.55rem;font-weight:800;color:var(--ink-900);margin:0;display:flex;align-items:center;gap:10px;">
                <span style="width:38px;height:38px;background:linear-gradient(135deg,#f59e0b,#fbbf24);border-radius:10px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:17px;flex-shrink:0;">
                    <i class="bi bi-pencil-fill"></i>
                </span>
                Edit Product
            </h1>
        </div>
        <a asp-action="Index" style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#fff;border:1.5px solid var(--line,#e5e7eb);border-radius:9px;font-size:13px;font-weight:600;color:var(--ink-700);text-decoration:none;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='#fff'">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    @* ── Form Card ── *@
    <div style="background:#fff;border:1px solid var(--line,#e5e7eb);border-radius:14px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);">

        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--line,#e5e7eb);background:#fafbfc;display:flex;align-items:center;gap:10px;">
            <i class="bi bi-pencil-square" style="color:#f59e0b;font-size:16px;"></i>
            <span style="font-size:14px;font-weight:700;color:var(--ink-700);">Update Product Details</span>
            <span style="margin-left:auto;font-size:12px;color:var(--ink-400);">Fields marked <span style="color:#ef4444;">*</span> are required</span>
        </div>

        <form asp-action="Edit" asp-route-id="@ViewData["ProductId"]" method="post" style="padding:1.5rem;" novalidate>
            @Html.AntiForgeryToken()
            <partial name="_ProductForm" model="Model" />
        </form>
    </div>
</div>
