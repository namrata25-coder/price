@model ProductListViewModel
@{
    ViewData["Title"] = "Product Management";
    ViewData["ActivePage"] = "PortfolioProduct";
}

<div style="max-width:1440px;margin:0 auto;padding:1.5rem 1.75rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
        <div>
            <div style="font-size:12px;font-weight:600;color:var(--ink-500);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">Portfolio Management</div>
            <h1 style="font-size:1.6rem;font-weight:800;color:var(--ink-900);margin:0;">
                <i class="bi bi-box-seam" style="color:var(--brand-600);margin-right:8px;"></i>Product Management
            </h1>
        </div>
        @if (ViewData["CanCreateProduct"] is true)
        {
            <a asp-action="Create" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;font-weight:600;">
                <i class="bi bi-plus-lg"></i> Add Product
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <form method="get" asp-action="Index" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:10px;padding:.75rem 1rem;margin-bottom:1rem;">
        <label for="productSearch" style="font-size:13px;font-weight:600;color:var(--ink-600);">Search</label>
        <input id="productSearch" name="search" value="@Model.Search" type="search" placeholder="Search products..."
               style="min-width:220px;flex:1;max-width:420px;padding:8px 11px;border:1px solid var(--line);border-radius:8px;font-size:13px;" />
        <button type="submit" class="btn btn-outline"><i class="bi bi-search"></i> Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-action="Index" class="btn btn-outline">Clear</a>
        }
        <span style="font-size:12.5px;color:var(--ink-500);margin-left:auto;">@Model.TotalCount product@(Model.TotalCount == 1 ? "" : "s")</span>
    </form>

    <div style="background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.03);">
        <div style="overflow-x:auto;">
            <table class="table-custom" style="width:100%;min-width:1050px;border-collapse:collapse;text-align:left;font-size:13px;">
                <thead style="background:#f8fafc;border-bottom:1px solid var(--line);">
                    <tr>
                        <th style="padding:12px 14px;">S.No.</th>
                        <th style="padding:12px 14px;">Product Name</th>
                        <th style="padding:12px 14px;">Description</th>
                        <th style="padding:12px 14px;">Features</th>
                        <th style="padding:12px 14px;text-align:right;">Price</th>
                        <th style="padding:12px 14px;">URL</th>
                        <th style="padding:12px 14px;text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="padding:3rem;text-align:center;color:var(--ink-500);">
                                No products found. Add a product to get started.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Products.Count; index++)
                        {
                            var product = Model.Products[index];
                            <tr style="border-bottom:1px solid var(--line);">
                                <td style="padding:12px 14px;">@((Model.Page - 1) * Model.PageSize + index + 1)</td>
                                <td style="padding:12px 14px;font-weight:700;color:var(--ink-900);">@product.Name</td>
                                <td style="padding:12px 14px;max-width:260px;white-space:pre-line;">@product.Description</td>
                                <td style="padding:12px 14px;max-width:220px;white-space:pre-line;">@product.Features</td>
                                <td style="padding:12px 14px;text-align:right;white-space:nowrap;">@product.Price.ToString("0.00")</td>
                                <td style="padding:12px 14px;max-width:200px;overflow-wrap:anywhere;">
                                    @if (!string.IsNullOrWhiteSpace(product.Url))
                                    {
                                        <a href="@product.Url" target="_blank" rel="noopener noreferrer">@product.Url</a>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ink-400);">—</span>
                                    }
                                </td>
                                <td style="padding:10px 12px;text-align:center;white-space:nowrap;">
                                    <a asp-action="Details" asp-route-id="@product.Id" title="View product" class="btn btn-sm btn-outline"><i class="bi bi-eye"></i></a>
                                    @if (ViewData["CanEditProduct"] is true)
                                    {
                                        <a asp-action="Edit" asp-route-id="@product.Id" title="Edit product" class="btn btn-sm btn-outline"><i class="bi bi-pencil"></i></a>
                                    }
                                    @if (ViewData["CanDeleteProduct"] is true)
                                    {
                                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this product?');">
                                            <button type="submit" title="Delete product" class="btn btn-sm btn-outline" style="color:#dc2626;"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Product pages" style="display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-top:1rem;">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-outline btn-sm">Previous</a>
            }
            <span style="font-size:13px;color:var(--ink-600);">Page @Model.Page of @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-outline btn-sm">Next</a>
            }
        </nav>
    }
</div>
